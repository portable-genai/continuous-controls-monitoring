# Golden control-test cases (obviously fictional). The engine grades each; the metrics score the
# engine against these OWN labels (expected_passed / expected_operating), an independent oracle.
# Fields: id, test_kind, control_id, in_inventory, severity, criteria{...}, records[...],
# expected_passed, expected_operating. Optional: narration + narration_grounded (groundedness),
# planted (a raw identifier that must be masked from the redacted audit summary; NRIC values must
# be checksum-valid or the redactor will not mask them).
{"id": "cfg-pass", "test_kind": "config_scan", "control_id": "SC-7-egress", "severity": "high", "criteria": {"gate_severity": "high", "expected_attributes": {"public_access_prevention": "enforced"}}, "records": [{"id": "bucket-a", "public_access_prevention": "enforced"}], "expected_passed": true, "expected_operating": "effective"}
{"id": "cfg-fail", "test_kind": "config_scan", "control_id": "SC-7-egress", "severity": "high", "criteria": {"gate_severity": "high", "expected_attributes": {"public_access_prevention": "enforced"}}, "records": [{"id": "bucket-b", "public_access_prevention": "inherited"}], "expected_passed": false, "expected_operating": "deficient"}
{"id": "recert-pass", "test_kind": "access_recert", "control_id": "AC-2-recert", "severity": "high", "criteria": {"gate_severity": "high", "max_recert_age_days": 90}, "records": [{"id": "ent-1", "recertified_days_ago": "30"}], "expected_passed": true, "expected_operating": "effective"}
{"id": "recert-fail", "test_kind": "access_recert", "control_id": "AC-2-recert", "severity": "high", "criteria": {"gate_severity": "high", "max_recert_age_days": 90}, "records": [{"id": "ent-2", "recertified_days_ago": "240"}], "expected_passed": false, "expected_operating": "deficient"}
{"id": "sample-pass", "test_kind": "transaction_sample", "control_id": "TX-settle-dualauth", "severity": "critical", "criteria": {"gate_severity": "high", "max_exceptions": 0}, "records": [{"id": "tx-1", "outcome": "dual_authorised"}], "expected_passed": true, "expected_operating": "effective"}
{"id": "sample-fail", "test_kind": "transaction_sample", "control_id": "TX-settle-dualauth", "severity": "critical", "criteria": {"gate_severity": "high", "max_exceptions": 0}, "records": [{"id": "tx-2", "outcome": "exception"}], "expected_passed": false, "expected_operating": "deficient"}
{"id": "threshold-pass", "test_kind": "threshold", "control_id": "SEC-patch-sla", "severity": "medium", "criteria": {"gate_severity": "medium", "threshold_value": 30.0, "threshold_direction": "max"}, "records": [{"id": "cve-1", "value": "12"}], "expected_passed": true, "expected_operating": "effective"}
{"id": "threshold-fail", "test_kind": "threshold", "control_id": "SEC-patch-sla", "severity": "medium", "criteria": {"gate_severity": "medium", "threshold_value": 30.0, "threshold_direction": "max"}, "records": [{"id": "cve-2", "value": "95"}], "expected_passed": false, "expected_operating": "deficient"}
{"id": "no-evidence", "test_kind": "config_scan", "control_id": "SC-7-egress", "severity": "high", "criteria": {"gate_severity": "high", "expected_attributes": {"public_access_prevention": "enforced"}}, "records": [], "expected_passed": false, "expected_operating": "deficient"}
{"id": "not-in-inventory", "test_kind": "config_scan", "control_id": "GHOST-1", "in_inventory": false, "severity": "high", "criteria": {"gate_severity": "high", "expected_attributes": {"public_access_prevention": "enforced"}}, "records": [{"id": "bucket-c", "public_access_prevention": "enforced"}], "expected_passed": false, "expected_operating": "effective"}
{"id": "pii-fail", "test_kind": "config_scan", "control_id": "SC-7-egress", "severity": "high", "criteria": {"gate_severity": "high", "expected_attributes": {"public_access_prevention": "enforced"}}, "records": [{"id": "bucket-owned-by-S1234567D", "public_access_prevention": "inherited"}], "expected_passed": false, "expected_operating": "deficient", "planted": "S1234567D"}
{"id": "narr-grounded", "test_kind": "config_scan", "control_id": "SC-7-egress", "severity": "high", "criteria": {"gate_severity": "high", "expected_attributes": {"public_access_prevention": "enforced"}}, "records": [{"id": "bucket-d", "public_access_prevention": "inherited"}], "expected_passed": false, "expected_operating": "deficient", "narration": "{\"headline\": \"Egress control failed\", \"body\": \"1 bucket drifted from the enforced baseline.\"}", "narration_grounded": true}
